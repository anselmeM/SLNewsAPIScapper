datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  link        String   @unique
  author      String
  description String?
  category    String[]
  imageUrl    String?
  paragraphs  String[]
  pubDate     DateTime
  source      String
  createdAt   DateTime @default(now())

  @@index([pubDate])
  @@index([source])
  @@index([createdAt])
}

model Video {
  id           Int      @id @default(autoincrement())
  videoId      String   @unique
  title        String
  url          String   @unique
  description  String?
  thumbnailUrl String?
  channelId    String
  channelTitle String
  publishedAt  DateTime
  category     String[]
  createdAt    DateTime @default(now())

  @@index([publishedAt])
  @@index([channelTitle])
  @@index([createdAt])
}
