datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: the pg_trgm (gin_trgm_ops) indexes backing the ILIKE '%term%' search
// predicates (Article.title/description, Video.title/description/channelTitle)
// live only in migrations/20261021000000_search_indexes/migration.sql — Prisma
// cannot model non-default index operator classes, so `migrate dev` must never
// be allowed to drop them.

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  link        String   @unique
  author      String
  description String?
  category    String[]
  imageUrl    String?
  paragraphs  String[]
  pubDate     DateTime
  source      String
  createdAt   DateTime @default(now())

  @@index([pubDate])
  @@index([source])
  @@index([createdAt])
  @@index([source, pubDate])
  @@index([pubDate, id])
  @@index([category], type: Gin)
}

model Video {
  id           Int      @id @default(autoincrement())
  videoId      String   @unique
  title        String
  url          String   @unique
  description  String?
  thumbnailUrl String?
  channelId    String
  channelTitle String
  publishedAt  DateTime
  category     String[]
  createdAt    DateTime @default(now())

  @@index([publishedAt])
  @@index([channelTitle])
  @@index([createdAt])
  @@index([channelTitle, publishedAt])
  @@index([publishedAt, id])
  @@index([category], type: Gin)
}
