datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: the pg_trgm (gin_trgm_ops) indexes backing the ILIKE '%term%' search
// predicates (Article.title/description, Video.title/description/channelTitle)
// live only in migrations/20261021000000_search_indexes/migration.sql — Prisma
// cannot model non-default index operator classes, so `migrate dev` must never
// be allowed to drop them.

model Article {
  id                   Int       @id @default(autoincrement())
  title                String
  link                 String    @unique
  author               String
  description          String?
  category             String[]
  imageUrl             String?
  paragraphs           String[]
  pubDate              DateTime
  // Date provenance: 'published' (trusted), 'clamped' (implausible date adjusted)
  // or 'missing' (no parseable date; stored for the internal app, excluded from
  // the sellable /v1 feed). pubDateRaw keeps the publisher's original string.
  pubDateSource        String    @default("published")
  pubDateRaw           String?
  // Content provenance: 'page' | 'feed' | 'empty'; null = legacy/unknown row.
  // contentAttempts counts failed body fetches so repair work is bounded.
  contentSource        String?
  contentAttempts      Int       @default(0)
  lastContentAttemptAt DateTime?
  source               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([pubDate])
  @@index([source])
  @@index([createdAt])
  @@index([source, pubDate])
  @@index([pubDate, id])
  @@index([contentSource])
  @@index([category], type: Gin)
}

model Video {
  id                Int      @id @default(autoincrement())
  videoId           String   @unique
  title             String
  url               String   @unique
  description       String?
  thumbnailUrl      String?
  channelId         String
  channelTitle      String
  publishedAt       DateTime
  // Date provenance, same semantics as Article.pubDateSource.
  publishedAtSource String   @default("published")
  publishedAtRaw    String?
  category          String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([publishedAt])
  @@index([channelTitle])
  @@index([createdAt])
  @@index([channelTitle, publishedAt])
  @@index([publishedAt, id])
  @@index([category], type: Gin)
}

// Customer API keys (sellable-product credential model).
//
// Only the SHA-256 hash of a key is stored: the raw `slk_...` value is shown
// once at creation time (see scripts/api-keys.ts) and can never be recovered.
// `scopes` holds the granted scopes (`v1:read`, `internal:read`); the static
// API_KEY and Clerk session JWTs get their scopes from env instead.
model ApiKey {
  id         Int           @id @default(autoincrement())
  name       String
  keyHash    String        @unique
  scopes     String[]
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  usage      ApiKeyUsage[]

  @@index([active])
}

// Per-key, per-UTC-day request counters for usage metering/billing groundwork.
model ApiKeyUsage {
  id       Int      @id @default(autoincrement())
  apiKeyId Int
  day      DateTime @db.Date
  requests Int      @default(0)
  apiKey   ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, day])
  @@index([day])
}
