{
  "name": "sl-news-api-scraper",
  "version": "1.0.0",
  "description": "Sierra Leone News API Scraper - Aggregates articles from local news outlets",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "npx prisma generate && npx prisma db push --accept-data-loss",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "scrape": "ts-node src/scrape.ts"
  },
  "keywords": [
    "sierra-leone",
    "news",
    "scraper",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
