DATABASE_URL="postgresql://user:password@localhost:5432/sl_news"
PORT=3000
API_KEY="your-secret-key-here"
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN="*"

# Optional Clerk session-JWT auth. Both are optional: with CLERK_SECRET_KEY
# unset, only the static API_KEY above is accepted — exactly as before — so the
# SLNews app/PWA's bearer key keeps working either way.
# Clerk secret key for the instance that issues the session JWTs. Enables the
# second auth path; JWKS fetching/caching is handled by @clerk/backend.
CLERK_SECRET_KEY=
# Optional comma-separated allowlist of `azp` origins (e.g. the PWA origin).
# Only used when CLERK_SECRET_KEY is set; blank means "do not restrict by party".
CLERK_AUTHORIZED_PARTIES=
