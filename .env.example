# Database connection string (required). Render injects the real value; never commit it.
DATABASE_URL="postgresql://user:password@localhost:5432/sl_news"

# Server
PORT=3000
# `production` on Render (JSON logs, production hardening). Use `development` locally.
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated list of allowed browser origins. `*` allows any origin.
CORS_ORIGIN="*"

# Static API key required on every request, sent as `Authorization: Bearer <key>`.
API_KEY="your-secret-key-here"

# Number of reverse-proxy hops to trust for `X-Forwarded-For`
# (Render terminates TLS in front of the app, so 1 is correct there).
TRUST_PROXY_HOPS=1

# Rate limiting: max requests per client per window, and the window in milliseconds
# (these defaults are 100 requests per 15 minutes).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Observability: maximum acceptable ingestion lag before `/api/stats` reports the
# article/video feeds as stale, in milliseconds (default 2 hours). No ingested
# data is always reported stale.
FRESHNESS_MAX_AGE_MS=7200000

# Wall-clock budget for one full ingestion cycle, in milliseconds (default 45
# minutes). Once reached, no new source, sitemap page or video channel starts;
# the run finishes cleanly and the remainder is picked up next cycle.
INGESTION_DEADLINE_MS=2700000

# Optional User-Agent override for all scraper HTTP requests (news feeds,
# article pages, sitemaps, YouTube). Defaults to the Chrome desktop UA the
# scraper has always used, so leaving this unset changes nothing.
# SCRAPER_USER_AGENT="SLNewsBot/1.0 (+https://example.com/bot)"

# Optional Clerk session-JWT auth. Both are optional: with CLERK_SECRET_KEY
# unset, only the static API_KEY above is accepted — exactly as before — so the
# SLNews app/PWA's bearer key keeps working either way.
# Clerk secret key for the instance that issues the session JWTs. Enables the
# second auth path; JWKS fetching/caching is handled by @clerk/backend.
CLERK_SECRET_KEY=
# Optional comma-separated allowlist of `azp` origins (e.g. the PWA origin).
# Only used when CLERK_SECRET_KEY is set; blank means "do not restrict by party".
CLERK_AUTHORIZED_PARTIES=
